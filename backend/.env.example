# ── RoadGuard API environment ────────────────────────────────────────────────
# Copy to backend/.env for local development. Production values are set on the
# hosting platform (Railway / Render / Docker) — never commit real secrets.

# Runtime
NODE_ENV=development
PORT=5000
# Set to 1 when the API runs behind a reverse proxy (Railway/Render/Vercel/nginx)
# so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# Database
# Local (SQLite) — the default provider:
DATABASE_URL="file:./dev.db"
# Production (Supabase / Postgres) — switch schema.prisma `provider` to
# "postgresql" and use the *Direct* connection string (port 5432, not the
# pgbouncer pooler):
# DATABASE_URL="postgresql://postgres:<password>@db.example.supabase.co:5432/postgres?schema=public"

# JWT — rotate in production:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — comma-separated origins allowed to call the API cross-origin
CORS_ORIGIN=http://localhost:5173

# Cloudinary (optional) — when all three are set, photos upload to Cloudinary;
# otherwise they store to local /uploads (served at /uploads/*).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=roadguard
