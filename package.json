{
  "name": "smart-pothole-detection-system",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Pothole Detection and Reporting System — enterprise citizen-reporting platform with user & admin dashboards",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "db:reset": "npm run prisma:reset -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "esbuild",
    "sharp",
    "core-js"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "sharp@0.33.5": true,
    "core-js@3.50.0": true
  }
}
